# 复制为 `.env`，并将每个路径、origin 和 CIDR 替换为当前部署的实际值。
MEDIAFLOW_IMAGE=mediaflow:0.2.0-m2
PUID=1000
PGID=1000
MEDIAFLOW_BIND_ADDRESS=0.0.0.0
MEDIAFLOW_PORT=3000
MEDIAFLOW_CONFIG_PATH=/volume1/docker/mediaflow/config
MEDIAFLOW_INCOMING_PATH=/volume1/media/incoming
MEDIAFLOW_ROOTS_CONFIG_PATH=/volume1/docker/mediaflow/deployment-roots.json
MEDIAFLOW_BOOTSTRAP_SECRET_PATH=/volume1/docker/mediaflow/secrets/bootstrap.secret
MEDIAFLOW_PUBLIC_ORIGIN=https://mediaflow.example.com
MEDIAFLOW_TRUSTED_PROXY_CIDRS=172.20.0.0/24
TZ=Asia/Shanghai
